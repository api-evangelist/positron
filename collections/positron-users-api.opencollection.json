{
  "opencollection": "1.0.0",
  "info": {
    "name": "Olivaw Admin Users API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Gets a list of all users.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/users"
          },
          "docs": "Lists the currently available users, providing basic information about each user.\n"
        },
        {
          "info": {
            "name": "Gets a information about a single user.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/users/:user",
            "params": [
              {
                "name": "user",
                "value": "",
                "type": "path",
                "description": "The ID of the user to use for this request"
              }
            ]
          },
          "docs": "Shows the selected users, providing basic information about each user.\n"
        },
        {
          "info": {
            "name": "Updates a specific user by user id.",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "{{baseUrl}}/users/:user",
            "params": [
              {
                "name": "user",
                "value": "",
                "type": "path",
                "description": "The ID of the user to update"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Alters information about the user"
        },
        {
          "info": {
            "name": "Deletes a specific user by user id.",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/users/:user",
            "params": [
              {
                "name": "user",
                "value": "",
                "type": "path",
                "description": "The ID of the user to use for this request"
              }
            ]
          },
          "docs": "Removes a user from the list of available users"
        },
        {
          "info": {
            "name": "Create a new user",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/users/new",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a user entry\n"
        }
      ]
    }
  ],
  "bundled": true
